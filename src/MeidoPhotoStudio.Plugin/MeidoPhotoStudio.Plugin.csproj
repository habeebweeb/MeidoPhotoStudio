<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="../../lib/Assembly-UnityScript-firstpass.dll" />
    <Reference Include="../../ref/COM3D2.MaidLoader.dll" />
    <Reference Include="../../ref/COM3D2.ShiftClickExplorer.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="COM3D2.GameLibs" Version="2.44.1-r.0" />
    <PackageReference Include="UnityEngine" Version="5.6.1" />
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.19" />
    <PackageReference Include="HarmonyX" Version="2.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3" />
    <PackageReference Include="ValueTupleBridge" Version="0.1.5" />
    <PackageReference Include="TaskParallelLibrary.Repackaged" Version="1.0.4-custom" />
  </ItemGroup>

  <ItemGroup>

    <ProjectReference
      Include="../MeidoPhotoStudio.Plugin.Analyzer/MeidoPhotoStudio.Plugin.Analyzer.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="Analyzer"
      SetTargetFramework="TargetFramework=netstandard2.0"
      />

    <ProjectReference
      Include="../COM3D2X.SafeEnum/COM3D2X.SafeEnum.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="Analyzer"
      SetTargetFramework="TargetFramework=netstandard2.0"
      />

  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Config/MeidoPhotoStudio/Translations/en/translation.ui.json" />
    <AdditionalFiles Include="Config/MeidoPhotoStudio/Translations/en/translation.props.json" />
    <AdditionalFiles Include="Config/MeidoPhotoStudio/Translations/en/translation.bg.json" />
    <AdditionalFiles Include="Config/MeidoPhotoStudio/Translations/en/translation.face.json" />
  </ItemGroup>

</Project>
